# Payram Updater Configuration
# Copy this file to /etc/payram/updater.env and adjust the values.
#
# setup_payram_updater.sh writes these same settings on a new install. When it
# runs again it never changes a value that is already here; it only adds the
# settings that are missing, with the defaults below.

# HTTP API port (default: 2567). The updater listens on 127.0.0.1 and on the
# docker0 bridge only, and answers only localhost and the PayRam container.
UPDATER_PORT=2567

# Release policy (which versions exist and which upgrades are allowed) and the
# runtime manifest (how the PayRam container is run). Both are required.
POLICY_URL=https://raw.githubusercontent.com/PayRam/payram-scripts/refs/heads/main/updater-configs/upgrade-policy.json
RUNTIME_MANIFEST_URL=https://raw.githubusercontent.com/PayRam/payram-scripts/refs/heads/main/updater-configs/runtime-manifest.json

# Timeout in seconds for fetching the policy and the manifest (default: 10)
FETCH_TIMEOUT_SECONDS=10

# Where the updater keeps job state, logs and history
STATE_DIR=/var/lib/payram-updater

# Where the database backup taken before every upgrade is kept.
# The database credentials are read from the PayRam container; no PG_*
# settings are needed.
BACKUP_DIR=/var/lib/payram/backups
# Number of backups to keep (default: 10)
# BACKUP_RETENTION=10

# execute: clicking Update really upgrades PayRam (default).
# dry-run: upgrades are only validated; nothing is changed.
EXECUTION_MODE=execute

# How long (seconds) an upgrade waits for the new PayRam version to report
# healthy before it switches back to the previous version (default: 600)
HEALTH_CHECK_TIMEOUT_SECONDS=600

# Path to the docker binary
DOCKER_BIN=docker

# Supervisor programs inside the PayRam container that are never stopped
# during the pre-upgrade backup (comma-separated)
SUPERVISOR_EXCLUDE=postgres,postgresql
# Optional: if set, only these programs are stopped
SUPERVISOR_INCLUDE=

# Allow arbitrary version names (testing only)
DEBUG_VERSION_MODE=false

# Optional overrides, normally discovered automatically:
# TARGET_CONTAINER_NAME=payram
# IMAGE_REPO_OVERRIDE=payramapp/payram
# BACKUP_TIMEOUT_SECONDS=600
