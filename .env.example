# ======================================================
# Payram Updater - Local Development Environment
# ======================================================
# NOTE:
# - This file is intended for LOCAL TESTING ONLY.
# - Production deployments use /etc/payram/updater.env
#   (see packaging/examples/updater.env.example; the installer writes it).
# - Environment variables always override values in this file.
# ======================================================

# ------------------------------------------------------
# Server
# ------------------------------------------------------

# Localhost port for payram-updater HTTP API
UPDATER_PORT=2567


# ------------------------------------------------------
# Upgrade Policy and Runtime Manifest (required)
# ------------------------------------------------------

# Same defaults the installer writes. RUNTIME_MANIFEST_URL can also be a
# local file path (e.g. ./runtime-manifest.json) for development.
POLICY_URL=https://raw.githubusercontent.com/PayRam/payram-scripts/refs/heads/main/updater-configs/upgrade-policy.json
RUNTIME_MANIFEST_URL=https://raw.githubusercontent.com/PayRam/payram-scripts/refs/heads/main/updater-configs/runtime-manifest.json


# ------------------------------------------------------
# Fetch & Runtime Limits
# ------------------------------------------------------

# Timeout (seconds) for fetching policy / manifest
FETCH_TIMEOUT_SECONDS=10

# How long (seconds) an upgrade waits for PayRam to report healthy before it
# switches back to the previous version
HEALTH_CHECK_TIMEOUT_SECONDS=600


# ------------------------------------------------------
# Local State (host filesystem)
# ------------------------------------------------------

# Directory where the updater stores job state (status.json), logs and history.
# Running without root? Use a local path such as ./.payram-updater/state
STATE_DIR=/var/lib/payram-updater


# ------------------------------------------------------
# Execution
# ------------------------------------------------------

# Optional: target container name (default: discovered from the payramapp/payram image)
# TARGET_CONTAINER_NAME=payram

# Optional: base URL for payram-core health checks (default: discovered)
# CORE_BASE_URL=http://127.0.0.1:8080

# Execution mode: 'execute' (default, performs upgrades) or 'dry-run' (validate only, no changes)
EXECUTION_MODE=execute

# Allow arbitrary version names (testing only)
DEBUG_VERSION_MODE=false

# Path to docker binary
DOCKER_BIN=docker

# Supervisor quiesce controls
# Comma-separated list of programs to never stop
SUPERVISOR_EXCLUDE=postgres,postgresql
# Optional: if set, only these programs are stopped
SUPERVISOR_INCLUDE=


# ------------------------------------------------------
# Database Backups
# ------------------------------------------------------

# Backups are always taken before upgrades. Database credentials are read
# from the PayRam container; no PG_* settings are needed.
# Running without root? Use a local path such as ./data/backups
BACKUP_DIR=/var/lib/payram/backups

# Number of backups to retain (older backups are pruned)
BACKUP_RETENTION=10
